llm_agent = load_config(["~/.config/ask/llm-ollama.yaml"], type=LLMConfig, key="llm")
# llm = load_config(["~/.config/ask/llm-lmstudio-orchestrator.yaml"], type=LLMConfig, key="llm")
# llm_agent = load_config(["~/.config/ask/llm-lmstudio.yaml"], type=LLMConfig, key="llm")
# comment to disable trace. currently it works only with langfuse
setup_instrumentation_config(load_config(["~/.config/ask/trace.yaml"], type=TraceConfig, key="trace"), )

# setup yaml formatter for long strings
def str_representer(dumper, data):
    if len(data.splitlines()) > 1 or len(data) > 80:  # Use literal style for multiline or long strings
        return dumper.represent_scalar('tag:yaml.org,2002:str', data, style='|')
    return dumper.represent_scalar('tag:yaml.org,2002:str', data)
yaml.add_representer(str, str_representer)

