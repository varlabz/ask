#!/usr/bin/env -S uvx --from git+https://github.com/varlabz/ask ask-run

# Orchestrator Agent for Multi-Agent Workflow Design
# This agent takes a complex user task and breaks it down into a series of simpler, atomic
# tasks that can be delegated to specialized agents. Each agent is designed to perform
# a single function, ensuring clarity and efficiency in task execution.
# Strictly speaking, the LLM for the orchestrator is not the same as for the agents.


import sys
from pathlib import Path
from textwrap import dedent

import yaml
from pydantic import BaseModel, Field

from ask.core.agent import AgentASK
from ask.core.cache import CacheASK, CacheStoreJson
from ask.core.config import LLMConfig, TraceConfig, load_config
from ask.core.context import schema
from ask.core.instrumentation import setup_instrumentation_config
